{
    "manifest_version": 3,
    "name": "YTMamp",
    "version": "0.1.5",
    "description": "Retro-style mini-player connector for YouTube Music",
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "src/ytm_adapter.js",
                "src/content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "YTMamp",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "https://music.youtube.com/*"
    ],
    "permissions": [
        "tabs",
        "storage"
    ]
}