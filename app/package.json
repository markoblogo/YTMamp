{
  "name": "ytmamp",
  "version": "0.3.0",
  "description": "Retro mini-player for YouTube Music with a Chromium extension bridge.",
  "author": "markoblogo",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "clean": "node scripts/clean.js",
    "prebuild": "npm run clean",
    "dist": "npm run clean && electron-builder --mac --win --linux",
    "dist:mac": "npm run clean && electron-builder --mac",
    "dist:win": "npm run clean && electron-builder --win",
    "dist:linux": "npm run clean && electron-builder --linux",
    "lint": "node scripts/check-js.js",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^25.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.antonbiletskiy.ytmamp",
    "productName": "YTMamp",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "artifactName": "YTMamp-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "YTMamp-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "assets/icon.png",
      "artifactName": "YTMamp-${version}-linux.${ext}"
    },
    "dmg": {
      "title": "Install YTMamp",
      "icon": "assets/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asar": true
  }
}
